{
  "name": "patch-validator",
  "description": "Checks Daedalus script symbols and resource file names in a Gothic VDF patch for validity",
  "version": "1.2.0",
  "author": "Sören Zapp",
  "license": "MIT",
  "homepage": "https://github.com/szapp/patch-validator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szapp/patch-validator.git"
  },
  "bugs": {
    "url": "https://github.com/szapp/patch-validator/issues"
  },
  "keywords": [
    "ci",
    "gothic",
    "gothic1",
    "gothic2",
    "checks",
    "daedalus",
    "ninja",
    "github-actions"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "antlrgen": "antlr-ng -Dlanguage=TypeScript -o ./src/generated/ -v -l false --exact-output-dir -- ./g4/Daedalus.g4 && node scripts/normalize-line-endings.mjs",
    "build": "tsc --noEmit",
    "bundle": "npm run antlrgen && npm run check && npm run package",
    "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "ci": "biome ci",
    "package": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "all": "npm run antlrgen && npm run check && npm run test && npm run coverage && npm run package"
  },
  "volta": {
    "node": "24.15.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "antlr4ng": "^3.0.16",
    "glob": "^14.0.2",
    "humanize-duration": "^3.33.2",
    "true-case-path": "^2.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^25.8.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^4.1.12",
    "antlr-ng": "^1.0.10",
    "make-coverage-badge": "^1.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
